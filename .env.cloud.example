# ==============================================================================
# PRAGATHI VIDYALAYA - SCHOOL FEE MANAGEMENT SYSTEM (CLOUD FREE EDITION)
# ₹0/Month Permanent Free-Tier Cloud Deployment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Turso libSQL - 9 GB Free Tier)
# ------------------------------------------------------------------------------
# Create a free database at https://turso.tech
# Run: turso db create school-fee-db
# Run: turso db show school-fee-db --url
# Run: turso db tokens create school-fee-db
DATABASE_URL=sqlite+libsql://school-fee-db-[your-org].turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ------------------------------------------------------------------------------
# 2. FILE STORAGE CONFIGURATION (Google Drive API - 15 GB Free Tier)
# ------------------------------------------------------------------------------
# Enables cloud storage for student photos, generated fee receipts, and certificates.
# Options: "local" (uses disk storage) | "gdrive" (uses 15 GB free Google Drive)
STORAGE_PROVIDER=gdrive

# Parent Folder ID from Google Drive URL:
# (Open Google Drive -> Create folder e.g. "School_Fee_Data" -> copy the ID from URL:
#  https://drive.google.com/drive/folders/1ABCxyz_SAMPLE_FOLDER_ID)
GDRIVE_FOLDER_ID=1ABCxyz_SAMPLE_FOLDER_ID

# Google Service Account Credentials:
# Either provide the path to your service_account.json:
# GDRIVE_SERVICE_ACCOUNT_JSON=/etc/secrets/service_account.json
# OR paste the raw JSON string directly:
GDRIVE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email": "...@...iam.gserviceaccount.com"}

# ------------------------------------------------------------------------------
# 3. BACKEND SECURITY & JWT AUTHENTICATION (Render Free Web Service)
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-very-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Allowed CORS Origins (Include your Netlify domain in production)
# Example: https://pragathi-school.netlify.app,http://localhost:5173
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Netlify Free Tier)
# ------------------------------------------------------------------------------
# Set this in Netlify Environment Variables:
# VITE_API_BASE_URL=https://pragathi-school-fee-api.onrender.com/api
